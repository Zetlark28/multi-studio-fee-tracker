# Copy to .env and fill in real values. docker-compose reads .env automatically.

# Required. Secret used to sign JWTs — must be at least 32 bytes.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Optional. If both are set, an admin user is created at backend boot.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required. Postgres credentials, shared by the postgres and backend services.
DB_NAME=multistudiofeetracker
DB_USER=multistudiofeetracker
DB_PASSWORD=change-me-to-a-real-password
