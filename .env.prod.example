# Copy to .env on the EC2 host, next to docker-compose.prod.yml, and fill in
# real values. docker compose reads .env automatically.

# Required. Secret used to sign JWTs — must be at least 32 bytes.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Optional. If both are set, an admin user is created at backend boot.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required. Domain name the frontend nginx serves and requests a TLS
# certificate for (must match the certbot certificate's directory under
# /etc/letsencrypt/live/).
SERVER_NAME=your-domain.example.com

# Required. Postgres credentials, shared by the postgres and backend services.
DB_NAME=multistudiofeetracker
DB_USER=multistudiofeetracker
DB_PASSWORD=change-me-to-a-real-password

# Required. Private ECR registry the images are pulled from
# (<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com), and the tag to
# deploy — set by scripts/push-ecr.sh's VERSION when the images were pushed.
AWS_ACCOUNT_ID=
AWS_REGION=eu-west-1
ECR_REPO_BE=multi-studio-fee-tracker-be
ECR_REPO_FE=multi-studio-fee-tracker-fe
VERSION=latest
