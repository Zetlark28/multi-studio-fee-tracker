# Copy to push-ecr.env (gitignored) to set your defaults, or export these as env vars.

# Usually passed inline instead (VERSION=1.4.0 ./scripts/push-ecr.sh), left
# unset here so a stale value doesn't linger between releases.
# VERSION=1.4.0

AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=
ECR_REPO_BE=multi-studio-fee-tracker-be
ECR_REPO_FE=multi-studio-fee-tracker-fe
IMAGE_PLATFORM=linux/amd64
